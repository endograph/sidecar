{
  "name": "@projectors/sidecar-mono",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/sidecar build",
    "check": "bun run --cwd packages/sidecar check",
    "dev": "bun run --filter '*' dev",
    "test": "bun run --cwd packages/sidecar test",
    "release": "node scripts/release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "site": "bun run --cwd packages/marketing serve"
  },
  "engines": {
    "node": ">=20"
  }
}
